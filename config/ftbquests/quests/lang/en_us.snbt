	quest.1A2B3C4D5E6F7890.title: "{translate:\"task.1A2B3C4D5E6F7891.title\"}"
	quest.1A39147D2FC7AF3C.quest_subtitle: "นึ่งให้ร้อน"
	quest.1A3F6434B2919A16.quest_desc: ["&6มีโอกาส 1% ที่จะดรอปเมื่อสิ่งมีชีวิตที่อยู่ภายใต้เอฟเฟกต์ Berserk ถูกสังหาร &rการบริโภค 10 ชิ้นปลดล็อกความสามารถในการล็อก Wrath King ในหน้าจอ “Lock”"]
	quest.1AA35C0479B67340.quest_subtitle: "วิธีวิวัฒนาการที่ดีกว่า"
	quest.1ADD951F05FFD421.quest_subtitle: "เอาชนะโดยตรง!"
	quest.1ADD951F05FFD421.title: "สังหาร Sculptor - Master of the Arm (Kill the Sculptor - Master of the Arm)"
	quest.1AECBCFE5C2CD2C7.quest_desc: ["วิวัฒนาการโดยใช้โหมด “Integration” ของ Raphael, Lord of Wisdom ขณะตรงตามเงื่อนไขต่อไปนี้ทั้งหมด:", "- เป็น True Demon Lord", "- ชำนาญ Raphael, Lord of Wisdom", "- ชำนาญ Uriel, Lord of Vows", "- ชำนาญ Beelzebuth, Lord of Gluttony", "- มีสกิลที่ชำนาญอย่างน้อย 20 สกิล", "- ถึง EP สูงสุด 2,000,000 EP จะไม่ถูกใช้", "- มีมาจิคูลอย่างน้อย 1,000,000 มาจิคูล 1,000,000 จะถูกใช้หลังวิวัฒนาการสำเร็จ", "", "ในโหมดหลายผู้เล่นมีผู้ครอบครองสกิลนี้ได้เพียงคนเดียว หากต้องการยกเลิกข้อจำกัดนี้ ให้ใช้ /gamerule shubNiggurathTrulyUnique false"]
	quest.1AECBCFE5C2CD2C7.quest_subtitle: "เงื่อนไขการได้รับ ↓"
	quest.1AECBCFE5C2CD2C7.title: "&6【ขั้นสูง】&fUltimate Skill: Shub-Niggurath, Lord of Harvest"
	quest.1AF9B2AEF4CA630F.quest_desc: ["ใช้ Abyss Offering คลิกขวาที่ Abyss Altar ตรงกลางเพื่อเรียกมัน", "&6มีสองช่วงและมีสกิล: ทำให้การโจมตีธาตุน้ำใช้ไม่ได้ ทำให้ความเย็นใช้ไม่ได้ ความต้านทานการโจมตีกายภาพ ความต้านทานการแทง ความต้านทานพิษ ความต้านทานไฟฟ้าช็อต และความต้านทานคลื่นความร้อน"]
	quest.1AF9B2AEF4CA630F.quest_subtitle: "สัตว์ประหลาดแห่งห้วงลึก"
	quest.1AF9B2AEF4CA630F.title: "สงครามครูเสดต่อต้าน Leviathan (Crusade against Leviathan)"
	quest.1B277EAB185E607D.title: "Lesser Poison Taratect (低等毒性塔拉特克)"
	quest.1B715F3A51FC08CA.quest_subtitle: "[เลือกเส้นทาง คุณยังท้าทายทั้งหมดคนเดียวได้ด้วย]"
	quest.1BA1D9A0C6A07A87.quest_desc: ["ระบบถ้ำที่สว่างตามธรรมชาติอันกว้างใหญ่ นี่คือไบโอมใต้ดินขนาดมหึมาที่มีซากเมืองดวอร์ฟทั้งเมือง เป็นสภาพแวดล้อมเสี่ยงสูงผลตอบแทนสูงที่ผู้เล่นพบสิ่งมีชีวิตเชิงกลได้มากที่สุดและสมบัติที่มีค่าที่สุด", "", "หาเจอได้อย่างไร?", "คุณหาแผนที่ไปยังที่นั่นได้ในหีบภายในซากดวอร์ฟกลไกที่ถูกทิ้งร้างบนพื้นผิว"]
	quest.1BA1D9A0C6A07A87.quest_subtitle: "ซากเมืองดวอร์ฟ"
	quest.1C2128869B7673D7.quest_subtitle: "ทำอาหารโดยไม่มีเตาได้อย่างไร?"
	quest.1C367AE15A6C4B76.quest_desc: ["Grimoire ดรอปจากหีบหอคอยจอมเวทหลายแห่ง:", "", "Ruined Wizard Tower", "Rotted Wizard Tower", "Frozen Wizard Tower", "Buried Wizard Tower", "Burnt Wizard Tower"]
	quest.1C74FBA64D8DB9AB.title: "Ogre King (食人魔王)"
	quest.1CD3F15F43DC7C8F.quest_desc: ["ตาม&6N&rการตั้งชื่อสิ่งมีชีวิตที่ตั้งชื่อได้ทำได้เมื่อ HP ของเป้าหมายต่ำกว่า 25% ของสูงสุดหรืออยู่ภายใต้เอฟเฟกต์ความกลัว (ที่ผู้ตั้งชื่อกระตุ้น)", "", "&d[เชื่อง](-)&rใช้มานาเพียงพอที่จะทำให้เป้าหมายเชื่องเท่านั้น และ MP จะไม่ถูกใช้ถาวร", "", "&d[วิวัฒนาการ] (=)&rหากเกี่ยวข้อง จะทำให้ NPC เป้าหมายวิวัฒนาการ", "", "&d[ของขวัญ] (+)&rหากเกี่ยวข้อง จะทำให้ NPC เป้าหมายวิวัฒนาการ คูณ EP ของพวกเขาสิบเท่า และมีโอกาส 10% ที่จะใช้ถาวรสูงสุด 300% ของต้นทุนที่ต้องใช้ในการตั้งชื่อ", "", "{@pagebreak}", "&lถาม: ทำให้มอนสเตอร์หวาดกลัวอย่างไร?&r", "&lตอบ:&rใช้ coercion, domineering ฯลฯ ทำให้มอนสเตอร์หวาดกลัว ให้แน่ใจว่าคุณมีเงื่อนไขสำหรับการตั้งชื่ออย่างรวดเร็ว แล้วตั้งชื่อมัน", "(เมื่อชำนาญสกิลเช่น coercion และ domineering คุณปรับพลังได้ด้วย shift+ปุ่มสกิล+เมาส์ ยิ่งพลังต่ำ ความเสียหายยิ่งน้อย"]
	quest.1CD3F15F43DC7C8F.quest_subtitle: "ตั้งชื่ออย่างไร?"
	quest.1CF63C044EAFA8D7.quest_subtitle: "สิ่งมีชีวิตจาก Dark Forest และ Pale Forest"
	quest.1CF63C044EAFA8D7.title: "ผีเสื้อกลางคืนยักษ์บิน (The Flying Giant Moth)"
	quest.1D217C6641299B70.quest_subtitle: "พบได้ใน Dwarf Royal Tower"
	quest.1D217C6641299B70.title: "ธงอาณาจักรดวอร์ฟ (dwarven kingdom flag)"
