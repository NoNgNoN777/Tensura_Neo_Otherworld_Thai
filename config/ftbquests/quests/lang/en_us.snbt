	quest.07529A000076D20F.title: "Almiraj?"
	quest.0755AAA36D9BB609.quest_desc: ["[ { \"text\": \"ต้องทำก่อน: เควส Manuscript\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"3A3E98E35AA1FDAA\" } } ]"]
	quest.0755AAA36D9BB609.quest_subtitle: "คัดลอกเนื้อหาจาก Manuscript ลงใน Bestiary"
	quest.078B1E365E595290.quest_desc: ["ค้นหา Cursed Tombstone ในส่วนลึกของดันเจี้ยน แล้วคลิกขวาเพื่ออัญเชิญ Cursed Winged Remains", "", "&6สกิลของมันได้แก่ การลบล้างความเย็น การต้านทานการโจมตีทางกายภาพ การลบล้างความเจ็บปวด การต้านทานการโจมตี Holy การลบล้างพิษ การต้านทานสถานะผิดปกติ และการต้านทานการโจมตีทางจิต"]
	quest.078B1E365E595290.quest_subtitle: "ความเปลี่ยนแปลงในท้องทะเล"
	quest.078B1E365E595290.title: "ปราบ Cursed Winged Remains"
	quest.07BCD842AEA4A0C4.title: "{translate:\"task.AA1B2C3D4E5F6780.title\"}"
	quest.07D69899C52591E9.quest_desc: ["การต่อสู้มี 3 ระยะ ทุกครั้งที่พลังชีวิตลดลงหนึ่งในสามจะเข้าสู่ระยะถัดไป", "&6สกิลของมันได้แก่ การลบล้างการโจมตี Fire การลบล้างความร้อน การลบล้างสถานะผิดปกติ การเสริมความแข็งแกร่งของร่างกาย และ Steel Power", "", "หลังเอาชนะมัน Blazing Frenzied Soul จะเกิดได้ใน Nether Fortress"]
	quest.07D69899C52591E9.quest_subtitle: "เจ้าแห่งเปลวเพลิง"
	quest.07D69899C52591E9.title: "เอาชนะ Flame Demon"
	quest.07E64C0B306DB76F.quest_desc: ["หากต้องการวิวัฒนาการเป็น Demon Lord คุณต้องมีวิญญาณ 10,000 ดวง รับวิญญาณได้จากการสังหารสิ่งมีชีวิตต่าง ๆ ยิ่งสิ่งมีชีวิตมี EP สูง ก็ยิ่งมีวิญญาณมาก", "", "&lคุณสมบัติหลังวิวัฒนาการ&r", "ได้รับโบนัส EP &43 เท่า&r", "ค่าสถานะพันธมิตร&bเพิ่มเป็นสองเท่า&r", "พันธมิตร NPC บางส่วนวิวัฒนาการ", "&5Resistance Evolution&r ที่เข้าเงื่อนไขทั้งหมดจะถูกทำให้ใช้ไม่ได้", "", "&6คำแนะนำ: สะสม EP ไว้มาก ๆ ก่อน แล้วค่อยวิวัฒนาการเป็น Demon Lord เมื่อพร้อม จะใช้โบนัสได้คุ้มยิ่งขึ้น~&r", "", "ก่อนตื่นพลัง ผู้เล่นจะเข้าสู่พิธี &6“Harvest Festival”&r เป็นเวลา 3 นาที:", "", "นาทีแรก ผู้เล่นใช้สกิลไม่ได้ และถูกจำกัดการมองเห็นกับการเคลื่อนไหว ยูนิตผู้ติดตามทั้งหมดในระยะจะเปลี่ยนเป็นสถานะ “ติดตามและปกป้อง” โดยอัตโนมัติ", "", "เมื่อเข้าสู่นาทีที่ 2 ผู้เล่นจะเข้าสู่ “โหมดหลับ” ทันที", "", "ในนาทีสุดท้าย ผู้ติดตามและมอนสเตอร์ผู้ติดตามของผู้เล่นที่อยู่ในระยะจะเข้าสู่ “โหมดหลับ” โดยอัตโนมัติเช่นกัน", "เมื่อพิธีใกล้สิ้นสุด เอฟเฟกต์ภาพและเสียงจะค่อย ๆ รุนแรงขึ้น ใน 10 วินาทีสุดท้าย ผู้เล่นจะเริ่มกะพริบและลอยขึ้นช้า ๆ จนกว่าการตื่นพลังจะเสร็จสมบูรณ์"]
	quest.07E64C0B306DB76F.quest_subtitle: "สังหาร!"
	quest.07E64C0B306DB76F.title: "&6【เส้นทาง Demon Lord】&rเงื่อนไขการเป็น Demon Lord"
	quest.080F3F29AE3A1EDF.quest_desc: "มีโอกาสได้รับจากการสังหาร Demon ใน Netherworld หรือจากหีบใน Nether"
	quest.080F3F29AE3A1EDF.quest_subtitle: "วิธีได้รับ"
	quest.0813F465C4661060.title: "Small Poison Taratect (小型毒性塔拉特克)"
	quest.0831BD175FEF3A79.quest_desc: ["&l&6หากช่องสกิล 3 ช่องทางซ้ายบังหน้าจอ ให้เปิดหน้าข้อมูลส่วนตัวด้วยปุ่ม B แล้วกดปุ่มรูปเฟืองมุมขวาบนเพื่อปรับตำแหน่ง&r", "{image:ablazeaqzlcz:textures/ftb/interface.png width:145 height:100 align:center}"]
	quest.0831BD175FEF3A79.quest_subtitle: "ตำแหน่งส่วนประกอบหน้าจอ (ไม่ต้องปรับหากไม่ได้บังอะไร)"
	quest.0831BD175FEF3A79.title: "ขั้นที่หนึ่ง: ปรับหน้าจอ"
