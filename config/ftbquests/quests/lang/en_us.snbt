	quest.0FA7CF15D7DB68F8.quest_desc: ["เอาชนะบอส Reinhard เพื่อรับสกิลนี้"]
	quest.0FA7CF15D7DB68F8.quest_subtitle: "เงื่อนไข↓"
	quest.0FA7CF15D7DB68F8.title: "&6【ขั้นสูง】&fได้รับ Unique Skill Blessed One"
	quest.125597B529D2CAEE.title: "&6【ขั้นสูง】&fได้รับ Unique Skill Merciless"
