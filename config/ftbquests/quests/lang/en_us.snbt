	quest.3DE59F19B491EDC7.quest_desc: ["&6หากคุณแลกสกิล Unique การใช้มันจะบริโภค Soul Energy", "[ { \"text\": \"Soul Energy\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"0FDA8DE439A0FC25\" } } ]", "", "&6หากคุณใช้ Character Reset Scroll โดยไม่ล็อกสกิลของคุณ สกิลเหล่านั้นจะหายไป", "[ { \"text\": \"ล็อกสกิล\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"166F39FFE1C98A63\" } } ]"]
