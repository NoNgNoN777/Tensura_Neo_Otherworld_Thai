	quest.19098B587950C0D2.quest_desc: ["พาหนะของคุณจะได้รับโบนัสความเร็ว", "&6&lGalloping 【ปลดล็อกสารานุกรมภาพ】", "{image:ablazeaqzlcz:textures/ftb/curios/cowboy_hat.png width:50 height:80 align:left}"]
